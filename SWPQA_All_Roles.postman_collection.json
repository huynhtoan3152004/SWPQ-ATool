                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token_admin', json.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Students",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "url": "{{auth_base}}/auth/students"
          }
        },
        {
          "name": "Get Teachers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const list = pm.response.json();",
                  "if (Array.isArray(list) && list.length > 0) {",
                  "  pm.collectionVariables.set('teacher_id', list[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "url": "{{auth_base}}/auth/teachers"
          }
        },
        {
          "name": "Change Role (optional)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"STUDENT\"\n}"
            },
            "url": "{{auth_base}}/auth/users/{{target_user_id}}/role"
          }
