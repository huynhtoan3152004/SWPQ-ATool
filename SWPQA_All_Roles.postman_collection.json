    {
      "name": "05 - Smoke E2E (Run Order)",
      "description": "Run folder this order: Login GVHD -> Get Teachers -> Create Semester -> Create Topic -> Login STUDENT -> Create Question -> Login TEACHER -> Create Answer -> Get Question Detail",
      "item": [
        {
          "name": "1) Login GVHD",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{gvhd_email}}\",\n  \"password\": \"{{default_password}}\"\n}" }, "url": "{{auth_base}}/auth/login" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const j = pm.response.json(); pm.collectionVariables.set('token_gvhd', j.accessToken);"] } }]
        },
        {
          "name": "2) Get Teachers",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token_gvhd}}" }], "url": "{{auth_base}}/auth/teachers" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const l=pm.response.json(); if(Array.isArray(l)&&l.length){pm.collectionVariables.set('teacher_id',l[0].id);} "] } }]
        },
        {
          "name": "3) Create Semester",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_gvhd}}" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"FALL\",\n  \"year\": 2026,\n  \"month\": 9\n}" }, "url": "{{question_base}}/semesters" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const j=pm.response.json(); if(j.id){pm.collectionVariables.set('semester_id',j.id);} "] } }]
        },
        {
          "name": "4) Create Topic",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_gvhd}}" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Software Architecture\",\n  \"semesterId\": \"{{semester_id}}\",\n  \"lecturerId\": \"{{teacher_id}}\"\n}" }, "url": "{{question_base}}/topics" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const j=pm.response.json(); if(j.id){pm.collectionVariables.set('topic_id',j.id);} "] } }]
        },
        {
          "name": "5) Login STUDENT",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{student_email}}\",\n  \"password\": \"{{default_password}}\"\n}" }, "url": "{{auth_base}}/auth/login" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const j=pm.response.json(); pm.collectionVariables.set('token_student',j.accessToken); pm.collectionVariables.set('student_id',j.userId);"] } }]
        },
        {
          "name": "6) Create Question",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_student}}" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"E2E question {{$timestamp}}\",\n  \"content\": \"Please explain eventual consistency in microservices\",\n  \"topicId\": \"{{topic_id}}\",\n  \"semesterId\": \"{{semester_id}}\",\n  \"visibility\": \"PUBLIC\"\n}" }, "url": "{{question_base}}/questions" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const j=pm.response.json(); if(j.id){pm.collectionVariables.set('question_id',j.id);} "] } }]
        },
        {
          "name": "7) Login TEACHER",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{teacher_email}}\",\n  \"password\": \"{{default_password}}\"\n}" }, "url": "{{auth_base}}/auth/login" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const j=pm.response.json(); pm.collectionVariables.set('token_teacher',j.accessToken); pm.collectionVariables.set('teacher_id',j.userId);"] } }]
        },
        {
          "name": "8) Create Answer",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_teacher}}" }], "body": { "mode": "raw", "raw": "{\n  \"questionId\": \"{{question_id}}\",\n  \"content\": \"Use outbox/inbox patterns and idempotent handlers.\"\n}" }, "url": "{{answer_base}}/answers" }
        },
        {
          "name": "9) Verify Question is ANSWERED",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token_teacher}}" }], "url": "{{question_base}}/questions/{{question_id}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const j=pm.response.json(); pm.test('Question status is ANSWERED', () => pm.expect(j.status).to.eql('ANSWERED')); "] } }]
        }
      ]
    }
  ],
