              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token_gvhd', json.accessToken);",
                  "pm.collectionVariables.set('gvhd_id', json.userId);"
                ]
