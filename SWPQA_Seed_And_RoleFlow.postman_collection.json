          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_gvhd}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"SWPSP26-13\",\n  \"nameEn\": \"Online Learning Management System\",\n  \"nameVn\": \"Hệ thống quản lý học tập trực tuyến\",\n  \"submittedBy\": \"MinhNT01\",\n  \"responsibleBy\": \"MinhNT01\",\n  \"context\": \"Hỗ trợ học online.\",\n  \"problems\": \"Thiếu nền tảng học tập tập trung.\",\n  \"actors\": \"Student, Teacher, Admin\",\n  \"functionalRequirements\": \"Upload bài học; Làm bài tập; Chấm điểm\",\n  \"references\": null,\n  \"semesterId\": \"{{semester_id}}\",\n  \"lecturerId\": \"{{teacher_seed_id}}\"\n}" },
