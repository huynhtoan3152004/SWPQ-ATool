{
  "info": {
    "name": "SWP Q&A - Seed Data + Lecturer Role Flow",
    "_postman_id": "d7f2d88f-a013-4c9f-81ea-6f36d8f0c9a1",
    "description": "Luồng Postman hoàn chỉnh: đăng ký giảng viên -> duyệt role -> seed 10 topics -> hỏi/duyệt/trả lời câu hỏi.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Lecturer Registration + Role Approval",
      "item": [
        {
          "name": "1) Register Lecturer Candidate",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"{{lecturer_full_name}}\",\n  \"email\": \"{{lecturer_email}}\",\n  \"password\": \"{{default_password}}\"\n}"
            },
            "url": "{{auth_base}}/auth/register-lecturer"
          }
        },
        {
          "name": "2) Login ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token_admin', json.accessToken);",
                  "pm.collectionVariables.set('admin_id', json.userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{default_password}}\"\n}"
            },
            "url": "{{auth_base}}/auth/login"
          }
        },
        {
          "name": "3) Get Pending Role Requests",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const list = pm.response.json();",
                  "const candidateEmail = pm.collectionVariables.get('lecturer_email');",
                  "const candidate = Array.isArray(list) ? list.find(x => String(x.email).toLowerCase() === String(candidateEmail).toLowerCase()) : null;",
                  "if (candidate) {",
                  "  pm.collectionVariables.set('pending_user_id', candidate.userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "url": "{{auth_base}}/auth/users/pending-role-requests"
          }
        },
        {
          "name": "4) Approve Candidate to TEACHER",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"TEACHER\"\n}"
            },
            "url": "{{auth_base}}/auth/users/{{pending_user_id}}/role"
          }
        },
        {
          "name": "5) Login Approved Lecturer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token_teacher_seed', json.accessToken);",
                  "pm.collectionVariables.set('teacher_seed_id', json.userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{lecturer_email}}\",\n  \"password\": \"{{default_password}}\"\n}"
            },
            "url": "{{auth_base}}/auth/login"
          }
        }
      ]
    },
    {
