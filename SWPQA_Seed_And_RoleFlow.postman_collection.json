            "body": { "mode": "raw", "raw": "{\n  \"code\": \"SWPSP26-09\",\n  \"nameEn\": \"Online Food Donation Platform\",\n  \"nameVn\": \"Nền tảng quyên góp thực phẩm trực tuyến\",\n  \"submittedBy\": \"HieuNV02\",\n  \"responsibleBy\": \"HieuNV02\",\n  \"context\": \"Kết nối người có thực phẩm dư thừa với tổ chức từ thiện.\",\n  \"problems\": \"Lãng phí thực phẩm, thiếu kết nối giữa người cho và người nhận.\",\n  \"actors\": \"Donor, Charity, Admin\",\n  \"functionalRequirements\": \"Đăng bài quyên góp; Nhận yêu cầu; Theo dõi phân phối\",\n  \"references\": null,\n  \"semesterId\": \"{{semester_id}}\",\n  \"lecturerId\": \"{{teacher_seed_id}}\"\n}" },
