          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_gvhd}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"SWPSP26-12\",\n  \"nameEn\": \"Healthcare Appointment Booking System\",\n  \"nameVn\": \"Hệ thống đặt lịch khám bệnh trực tuyến\",\n  \"submittedBy\": \"BinhLT05\",\n  \"responsibleBy\": \"BinhLT05\",\n  \"context\": \"Đặt lịch khám bệnh online.\",\n  \"problems\": \"Quá tải bệnh viện, chờ đợi lâu.\",\n  \"actors\": \"Patient, Doctor, Admin\",\n  \"functionalRequirements\": \"Đặt lịch; Quản lý lịch khám; Nhắc lịch\",\n  \"references\": null,\n  \"semesterId\": \"{{semester_id}}\",\n  \"lecturerId\": \"{{teacher_seed_id}}\"\n}" },
            "url": "{{question_base}}/topics"
