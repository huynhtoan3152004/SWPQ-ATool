            "body": { "mode": "raw", "raw": "{\n  \"code\": \"SWPSP26-14\",\n  \"nameEn\": \"Job Recruitment Platform\",\n  \"nameVn\": \"Nền tảng tuyển dụng việc làm\",\n  \"submittedBy\": \"HieuNV02\",\n  \"responsibleBy\": \"HieuNV02\",\n  \"context\": \"Kết nối nhà tuyển dụng và ứng viên.\",\n  \"problems\": \"Khó tìm việc phù hợp.\",\n  \"actors\": \"Candidate, Recruiter, Admin\",\n  \"functionalRequirements\": \"Đăng job; Apply job; Tracking\",\n  \"references\": null,\n  \"semesterId\": \"{{semester_id}}\",\n  \"lecturerId\": \"{{teacher_seed_id}}\"\n}" },
            "url": "{{question_base}}/topics"
          }
