    {
      "name": "03 - Ask / Approve / Assign / Answer",
      "item": [
        {
          "name": "1) Login STUDENT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token_student', json.accessToken);",
                  "pm.collectionVariables.set('student_id', json.userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{student_email}}\",\n  \"password\": \"{{default_password}}\"\n}" },
            "url": "{{auth_base}}/auth/login"
          }
        },
        {
          "name": "2) Get Topic by Code (SWPSP26-08)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('topic_id', json.id);",
                  "pm.collectionVariables.set('semester_id', json.semesterId);",
                  "pm.collectionVariables.set('topic_code', json.code);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token_student}}" } ],
            "url": "{{question_base}}/topics/by-code/SWPSP26-08"
          }
        },
        {
          "name": "3) Create Question",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.id) pm.collectionVariables.set('question_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_student}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Question {{$timestamp}}\",\n  \"content\": \"Cho em hỏi kiến trúc service phù hợp cho đề tài này?\",\n  \"topicId\": \"{{topic_id}}\",\n  \"semesterId\": \"{{semester_id}}\",\n  \"visibility\": \"PUBLIC\"\n}"
            },
            "url": "{{question_base}}/questions"
          }
        },
        {
          "name": "4) Login GVHD",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token_gvhd', json.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{gvhd_email}}\",\n  \"password\": \"{{default_password}}\"\n}" },
            "url": "{{auth_base}}/auth/login"
          }
        },
        {
          "name": "5) Approve Question",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Authorization", "value": "Bearer {{token_gvhd}}" } ],
            "url": "{{question_base}}/questions/{{question_id}}/approve"
          }
        },
        {
          "name": "6) Assign To Topic Lecturer",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Authorization", "value": "Bearer {{token_gvhd}}" } ],
            "url": "{{question_base}}/questions/{{question_id}}/assign-topic-lecturer"
          }
        },
        {
          "name": "7) Login Approved Lecturer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token_teacher_seed', json.accessToken);",
                  "pm.collectionVariables.set('teacher_seed_id', json.userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{lecturer_email}}\",\n  \"password\": \"{{default_password}}\"\n}" },
            "url": "{{auth_base}}/auth/login"
          }
        },
        {
          "name": "8) Create Answer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_teacher_seed}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionId\": \"{{question_id}}\",\n  \"content\": \"Nên tách module theo bounded context và dùng event để đồng bộ trạng thái.\"\n}"
            },
            "url": "{{answer_base}}/answers"
          }
        },
        {
          "name": "9) Verify Question Answered",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('Question status is ANSWERED', function () { pm.expect(j.status).to.eql('ANSWERED'); });"
                ]
              }
            }
          ],
