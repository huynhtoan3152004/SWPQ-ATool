          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{gvhd_email}}\",\n  \"password\": \"{{default_password}}\"\n}"
            },
            "url": "{{auth_base}}/auth/login"
          }
        },
        {
          "name": "2) Create Semester SPRING 2026 (optional)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json && json.id) pm.collectionVariables.set('semester_id', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_gvhd}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"SPRING\",\n  \"year\": 2026,\n  \"month\": 3\n}"
            },
            "url": "{{question_base}}/semesters"
          }
        },
        {
          "name": "3) Get Semester SPRING 2026",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const list = pm.response.json();",
                  "const sem = Array.isArray(list) ? list.find(x => x.name === 'SPRING' && x.year === 2026 && x.month === 3) : null;",
                  "pm.test('SPRING 2026 exists', function () { pm.expect(!!sem).to.eql(true); });",
                  "if (sem) pm.collectionVariables.set('semester_id', sem.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_gvhd}}" }
            ],
            "url": "{{question_base}}/semesters"
          }
        },
        {
          "name": "4) Create Topic SWPSP26-08",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_gvhd}}" }
