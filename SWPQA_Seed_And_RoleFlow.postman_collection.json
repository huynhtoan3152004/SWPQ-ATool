          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_gvhd}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"SWPSP26-16\",\n  \"nameEn\": \"Fitness Tracking Application\",\n  \"nameVn\": \"Ứng dụng theo dõi sức khỏe và tập luyện\",\n  \"submittedBy\": \"AnPT04\",\n  \"responsibleBy\": \"AnPT04\",\n  \"context\": \"Theo dõi sức khỏe và tập luyện.\",\n  \"problems\": \"Người dùng thiếu động lực theo dõi sức khỏe.\",\n  \"actors\": \"User, Trainer\",\n  \"functionalRequirements\": \"Track workout; Goal setting; Analytics\",\n  \"references\": null,\n  \"semesterId\": \"{{semester_id}}\",\n  \"lecturerId\": \"{{teacher_seed_id}}\"\n}" },
