          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_gvhd}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"SWPSP26-15\",\n  \"nameEn\": \"Online Marketplace for Handmade Products\",\n  \"nameVn\": \"Sàn thương mại điện tử đồ handmade\",\n  \"submittedBy\": \"LinhTT03\",\n  \"responsibleBy\": \"LinhTT03\",\n  \"context\": \"Nền tảng bán đồ handmade.\",\n  \"problems\": \"Người bán nhỏ lẻ khó tiếp cận khách hàng.\",\n  \"actors\": \"Seller, Buyer, Admin\",\n  \"functionalRequirements\": \"Đăng sản phẩm; Mua hàng; Thanh toán\",\n  \"references\": null,\n  \"semesterId\": \"{{semester_id}}\",\n  \"lecturerId\": \"{{teacher_seed_id}}\"\n}" },
            "url": "{{question_base}}/topics"
          }
        },
